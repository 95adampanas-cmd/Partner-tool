# Skopiuj ten plik do backend/.env i wpisz prawdziwe wartości.
#
# .env jest w .gitignore — NIE trafia na GitHub ani na Render.
# Na Render klucze dodajesz ręcznie: Dashboard → Environment.
# Jeśli klucz gdziekolwiek wycieknie, unieważnij go u dostawcy. Nie da się
# go „odwołać" inaczej.

# ── Wymagane ──────────────────────────────────────────────────────────
# Silnik językowy całego narzędzia: research firmy, maile, czat, kategorie,
# generowanie pytań do audytu. Bez niego nie działa praktycznie nic.
# Klucz zakładasz na console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Potrzebny WYŁĄCZNIE do audytu GEO — i to nie jest pozostałość po migracji.
# `agent_pytajacy` udaje asystenta, któremu klient zadaje pytanie, a my sprawdzamy,
# czy w odpowiedzi padnie nazwa badanej firmy. Klienci pytają ChatGPT, więc ten
# jeden pomiar musi chodzić na modelu OpenAI z wyszukiwarką OpenAI. Gdyby stanął
# tu Claude, raport mówiłby „nie widać Cię w Claude" — inne zdanie, ta sama tabela.
#
# Bez tego klucza działa wszystko poza sekcją „pytania klientów" w audycie.
OPENAI_API_KEY=sk-...

# Wyszukiwanie firm po branży. Przyjmowana jest też nazwa TVLY_API_KEY.
TAVILY_API_KEY=tvly-...

# ── Mikroaudyt SEO/GEO ────────────────────────────────────────────────
# Jedyny dostawca danych SEO. Logowanie login/hasło, rozliczenie z depozytu
# (minimum wpłaty: $50).
#
# Bez środków na koncie audyt zwróci błąd zamiast raportu — i tak ma być.
# Raport z pustych danych wyglądałby jak wynik i powiedziałby partnerowi, że ma
# zerową widoczność. Jedyna sekcja, która przeżyje puste saldo, to „pytania
# klientów" — chodzi na naszym kluczu OpenAI, niezależnie.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Google (Custom Search) — opcjonalne, drugie źródło firm ───────────
# Prawdziwy indeks Google. Ma sens obok Tavily, bo widzą inny wycinek sieci:
# na frazie „agencja digital advisory" ich pierwsze dziesiątki pokrywały się
# w trzech domenach na dziewięć.
#
# Limit darmowy: 100 zapytań na dobę (jedna strona wyników = jedno zapytanie).
# Przy trzech wariantach frazy po dwie strony to ~16 wyszukiwań dziennie za darmo.
#
# Jak założyć — dwie rzeczy, obie wymagane:
#  1. KLUCZ: console.cloud.google.com → włącz „Custom Search API" → Dane
#     logowania → Utwórz → Klucz interfejsu API. Może to być ten sam projekt,
#     w którym masz Places API.
#  2. WYSZUKIWARKA: programmablesearchengine.google.com/controlpanel/create
#     → nazwa dowolna → ZAZNACZ „Przeszukuj całą sieć" (bez tego przeszuka
#     tylko wskazane strony i zwróci zero) → skopiuj „Identyfikator wyszukiwarki".
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# ── Mapy Google — opcjonalne, trzecie źródło firm ─────────────────────
# Znajduje firmy, które nie inwestują w SEO, więc nie wychodzą w wyszukiwarce.
# Pobieramy z Map WYŁĄCZNIE adres strony; dane zbiera nasz scraper z serwisu
# firmy (zasady Places API zabraniają przechowywania ich treści).
#
# Wymaga: projekt w Google Cloud + włączone "Places API (New)" + konto
# rozliczeniowe. Darmowy próg to 1000 zapytań/mies., a jedno zwraca do 20 firm.
GOOGLE_MAPS_API_KEY=

