# Sekrety — NIGDY na GitHub
# Wzorzec .env* celowo szeroki: reguly ".env" i "*.env" NIE lapaly kopii
# w rodzaju ".env.kopia" ani ".env.backup", a wlasnie takie pliki powstaja
# przy porzadkach i zawieraja komplet kluczy.
.env
.env*
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Dane generowane (eksporty firm)
*.csv

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node — jsdom potrzebny tylko do frontend/test_ui.js
node_modules/
dist/
package-lock.json
frontend/package.json

# raport z testu filtra (generowany)
raport_filtr.txt

# robocze zrzuty z weryfikacji API — surowe odpowiedzi, nie kod
backend/_*.txt

# fixtures z API (zawieraja dane, nie kod)
backend/fixtures/

# Baza z danymi firm — NIP-y, maile, telefony. Nigdy na GitHub.
backend/dane.db
backend/dane.db-wal
backend/dane.db-shm
